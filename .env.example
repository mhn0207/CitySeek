# 复制为 .env 后再按部署环境修改。请勿提交真实密码。
TZ=Asia/Shanghai

# MySQL
DB_USERNAME=cityseek
DB_PASSWORD=cityseek_db_change_me
MYSQL_ROOT_PASSWORD=cityseek_root_change_me

# Redis
REDIS_PASSWORD=cityseek_redis_change_me
REDIS_DATABASE=0

# 宿主机端口。后端默认只允许本机访问。
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081

# 应用
REDIS_INITIALIZE_CACHE=true
REDIS_STREAM_CONSUMER=cityseek-consumer-1
APP_LOG_LEVEL=info
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0